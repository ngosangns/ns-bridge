  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngosangns/ns-bridge.git"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "check": "pnpm -r --filter './packages/**' check",

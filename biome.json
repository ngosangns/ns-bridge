{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/*/test/**",
      "*.ts",
      "*.json",
      "!packages/pi-provider/**",
      "!packages/omp-provider/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": { "enabled": true },
  "json": {
    "formatter": { "trailingCommas": "none" }
  }
}

{
  "name": "ns-omp-provider",
  "version": "0.1.0",
  "description": "OMP (oh-my-pi) plugin: Kiro, Devin, and Grok providers from @ngosangns/ns-pi-provider, wrapped for OMP's provider/extension API.",
  "type": "module",
  "license": "MIT",
  "author": "ngosangns",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngosangns/ns-omp-provider.git"
  },
  "bugs": {
    "url": "https://github.com/ngosangns/ns-omp-provider/issues"
  },
  "homepage": "https://github.com/ngosangns/ns-omp-provider#readme",
  "keywords": [
    "omp",
    "omp-plugin",
    "oh-my-pi",
    "pi",
    "kiro",
    "devin",
    "grok",
    "xai",
    "provider",
    "oauth"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-omp.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.8.0",
    "@oh-my-pi/pi-coding-agent": ">=18.8.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ngosangns/ns-pi-provider": "0.1.7",
    "@types/node": "^22.18.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "rootDir": ".",
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@ngosangns/ns-pi-provider/kiro": ["./src/types/ns-pi-provider-kiro.d.ts"],
      "@ngosangns/ns-pi-provider/arnict": ["./src/types/ns-pi-provider-arnict.d.ts"],
      "@ngosangns/ns-pi-provider/qoder": ["./src/types/ns-pi-provider-qoder.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

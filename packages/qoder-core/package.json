{
  "name": "ns-qoder-core",
  "version": "0.1.0",
  "description": "Host-neutral Qoder client via qodercli and @qoder-ai/qoder-agent-sdk. Not published.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngosangns/ns-bridge.git",
    "directory": "packages/qoder-core"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "postinstall": "node scripts/ensure-sdk-runtime.cjs"
  },
  "dependencies": {
    "@qoder-ai/qoder-agent-sdk": "^1.0.56",
    "ns-core-utils": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "ns-bridge-core": "workspace:*"
  }
}

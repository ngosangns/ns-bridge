{
  "name": "@ngosangns/ns-bridge",
  "version": "0.1.27",
  "description": "Install ns-bridge providers into Pi, OMP, and DSH from prebuilt local bundles.",
  "type": "module",
  "license": "MIT",
  "author": "ngosangns",
  "bin": {
    "ns-bridge": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngosangns/ns-bridge.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs && chmod +x dist/main.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.hosts.json",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@smithy/core": "^3.34.1",
    "js-tiktoken": "^1.0.21",
    "supports-color": "^10.2.2"
  },
  "devDependencies": {
    "@ngosangns/ns-pi-provider": "workspace:*",
    "@types/node": "^22.18.6",
    "esbuild": "^0.28.2",
    "ns-arnict-core": "workspace:*",
    "ns-bridge-core": "workspace:*",
    "ns-core-utils": "workspace:*",
    "ns-devin-core": "workspace:*",
    "ns-dsh-llm-arnict": "workspace:*",
    "ns-dsh-llm-devin": "workspace:*",
    "ns-dsh-llm-grok": "workspace:*",
    "ns-dsh-llm-kiro": "workspace:*",
    "ns-dsh-llm-qoder": "workspace:*",
    "ns-grok-core": "workspace:*",
    "ns-kiro-core": "workspace:*",
    "ns-omp-provider": "workspace:*",
    "ns-qoder-core": "workspace:*",
    "typescript": "^5.9.2"
  }
}
